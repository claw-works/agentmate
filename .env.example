# Database
DATABASE_URL=[REDACTED_CONN_STRING]://localhost:5432/agentmate?sslmode=disable

# JWT
JWT_SECRET=[REDACTED_PASSWORD]
JWT_EXPIRY=24h

# Server
SERVER_PORT=26001

# MCP Server (optional, set MCP_USER_ID to enable)
MCP_PORT=26002
MCP_USER_ID=   # your user UUID from the users table

# MCP Server — set to a valid API key to enable MCP
AGENTMATE_API_KEY=
