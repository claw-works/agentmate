# Database
DATABASE_URL=postgres://agentmate:secret@localhost:5432/agentmate?sslmode=disable

# JWT
JWT_SECRET=change-me
JWT_EXPIRY=24h

# Server
SERVER_PORT=26001

# MCP uses Streamable HTTP on SERVER_PORT at /mcp and /mcp/skills.
# Auth: MCP clients must pass an API key via query param (?api_key=ak_xxx),
# X-Api-Key header, or Authorization: Bearer ak_xxx header.

# Retrieval / Vector Store
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=agentmate_retrieval
QDRANT_VECTOR_NAME=semantic
QDRANT_DISTANCE=Cosine

# OpenAI-compatible embeddings
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536
# EMBEDDING_API_KEY=
