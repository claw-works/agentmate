# Runtime
APP_ENV=dev
GIN_MODE=debug
SERVER_PORT=26001

# PostgreSQL
POSTGRES_USER=agentmate
POSTGRES_PASSWORD=agentmate_secret_2026
POSTGRES_DB=agentmate

# Host-side URL for local `go run` or local migration tools.
DATABASE_URL=postgres://agentmate:agentmate_secret_2026@localhost:15432/agentmate?sslmode=disable

# Docker-side URLs used by docker compose services.
DATABASE_URL_DOCKER=postgres://agentmate:agentmate_secret_2026@postgres:5432/agentmate?sslmode=disable
DATABASE_URL_MIGRATE=postgres://agentmate:agentmate_secret_2026@postgres:5432/agentmate?sslmode=disable

# JWT
JWT_SECRET=change-me
JWT_EXPIRY=24h

# MCP uses Streamable HTTP on SERVER_PORT at /mcp and /mcp/skills.
# Auth: MCP clients must pass an API key via query param (?api_key=ak_xxx),
# X-Api-Key header, or Authorization: Bearer ak_xxx header.

# Retrieval / Vector Store
QDRANT_URL=http://localhost:6333
QDRANT_URL_DOCKER=http://host.docker.internal:6333
QDRANT_COLLECTION=agentmate_retrieval
QDRANT_VECTOR_NAME=semantic
QDRANT_DISTANCE=Cosine
# QDRANT_API_KEY=

# OpenAI-compatible embeddings. Dev default uses DashScope text-embedding-v4.
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIMENSION=1024
EMBEDDING_ENCODING_FORMAT=float
# EMBEDDING_API_KEY=

# Cheap OpenAI-compatible LLM for rerank/extract/consolidation jobs.
CHEAP_LLM_BASE_URL=https://api.deepseek.com
CHEAP_LLM_CHAT_COMPLETIONS_URL=https://api.deepseek.com/chat/completions
CHEAP_LLM_MODEL=deepseek-v4-flash
# CHEAP_LLM_API_KEY=

# Retrieval service behavior
RETRIEVAL_TIMEOUT_SECONDS=15


# ─── Wiki compiler and reviewer (K3) ───
#
# Two independently configured LLM roles. Both fall back to EMBEDDING_BASE_URL and
# EMBEDDING_API_KEY, which is how a first deployment works on one credential —
# reviewer_independence then honestly reports same_provider on every build.
#
# Point the reviewer at a different vendor for real independence. A reviewer drawing
# on the same training data as the compiler misses the same things, so same-vendor
# review reduces correlation without producing impartiality. The genuinely
# independent anchors are check (mechanical) and human validation, not another model.
COMPILER_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
COMPILER_API_KEY=
COMPILER_MODEL=qwen3.7-plus
# Output budget is shared with the model's own reasoning tokens, so it must be a
# large multiple of the expected wiki rather than a snug fit. A truncated reply
# fails the build instead of producing a partial wiki.
COMPILER_MAX_TOKENS=32768
COMPILER_TIMEOUT_SECONDS=900
# Zero means "price unknown", not "free": cost is then recorded as 0 rather than as
# an invented number that looks authoritative.
COMPILER_INPUT_MICROS_PER_1K_TOKENS=0
COMPILER_OUTPUT_MICROS_PER_1K_TOKENS=0

REVIEWER_BASE_URL=https://api.deepseek.com
REVIEWER_API_KEY=
REVIEWER_MODEL=deepseek-v4-pro
REVIEWER_TIMEOUT_SECONDS=120
REVIEWER_INPUT_MICROS_PER_1K_TOKENS=0
REVIEWER_OUTPUT_MICROS_PER_1K_TOKENS=0

# ─── Wiki compile queue (K3.3) ───
#
# The lease duration is derived from COMPILER_TIMEOUT_SECONDS rather than set here:
# a lease shorter than a compile lets a healthy worker's build be reclaimed
# mid-compile, and two workers then write the same wiki.
WIKI_WORKER_CONCURRENCY=2
WIKI_WORKER_POLL_SECONDS=5
WIKI_WORKER_HEARTBEAT_SECONDS=15
WIKI_WORKER_RETRY_BACKOFF_SECONDS=30
WIKI_WORKER_MAX_RETRY_BACKOFF_SECONDS=600
